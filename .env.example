# ==============================================================================
# ClubReportHub - Environment Variables
# ==============================================================================

# Database (SQL Server 2022)
SQL_PASSWORD=ClubReportHub!2026

# Gateway Port (Exposed to Internet, default 7000 or change to 80)
GATEWAY_PORT=7000

# Allowed deployed frontend origin (scheme + hostname, no path or trailing slash)
FRONTEND_ORIGIN=https://fptux-legacy-ui.pages.dev

# Authentication & Security (Must be at least 32 characters)
JWT_SIGNING_KEY=ClubReportHub-Secure-Jwt-Secret-Key-2026-FPTU-Xperience

# Default Seed Passwords
ADMIN_SEED_PASSWORD=Admin@2026!
SYSTEM_ADMIN_SEED_PASSWORD=SystemAdmin@2026!
MANAGER_SEED_PASSWORD=Manager@2026!
STUDENT_AFFAIRS_SEED_PASSWORD=StudentAffairs@2026!
TREASURER_SEED_PASSWORD=Treasurer@2026!
STUDENT_SEED_PASSWORD=Student@2026!
RESET_SEED_PASSWORDS=true

# Redis Streams
REDIS_STREAM_NAME=clubreporthub-events
